@using System.Data
@{
    int rows=10;
    int cols=20;
}
<div>
    <h1 style="text-align: center;">Create Your Own Layout</h1>
    <div class="submit-form">
        <button class="btn btn-primary" onclick="submitLayout()">Submit Layout</button>
        <button class="btn btn-secondary" onclick="resetLayout()">Reset Layout</button>
    </div>
</div>

    <div class="editor-wrapper">
        <div class="editor-grid" style="grid-template-columns: repeat(@cols, 48px); grid-template-rows: repeat(@rows, 48px);">
            @for (int i = 1; i <= rows; i++)
            {
                @for (int j = 1; j <= cols; j++)
                {
                    <button class="cell" onclick="selectCell(this)" style="grid-column: @j; grid-row: @i;" data-row="@i" data-col="@j"></button>
                }
                
            }
        </div>
    </div>
    <form id="cell-form" class="cell-form hidden" onsubmit="saveCell(); return false;">   @* was a div. onsubmit runs on Enter or the Save button; return false stops the page reload *@
        <input type="text" id="cell-label" placeholder="Label value" />
        <input type="text" id="cell-price" placeholder="(BDT)0.00"/>
        <button type="submit" class="btn btn-success" id="save-cell">Save</button>   @* type="submit"; onclick removed, since onsubmit handles it *@
        <button type="button" class="btn btn-danger" id="cancel-cell" onclick="cancelCell()">Cancel</button>   @* type="button" so it doesn't submit the form *@
    </form>
    
