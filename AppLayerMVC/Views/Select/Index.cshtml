
@using BLL.Models;
@model List<Layout>

@{
    ViewData["Title"] = "Select Layout";
}
<h1 style="text-align: center;">Select Layout</h1>

<div class="table-container">
    <table>
        <tr>
            <th>Layouts</th>
        </tr>
        @foreach (var layout in Model)
        {
            <tr>
                <td>
                    <div class="select-layout">
                        <h3>@layout.Name</h3>
                        <p>@layout.Seats.Count() Seats</p>
                    <a href="@Url.Action("ViewLayout", "Home", new { id = layout.Id })" class="btn btn-primary">@layout.Name</a>
                    </div>
                </td>
                <td>
                    @* ADDED: mini preview in its own column. Same grid-column/grid-row idea as the customer view, just 10px cells *@
            <div class="mini-grid" style="grid-template-columns: repeat(@layout.Seats.Max(s => s.X), 10px)">
                @foreach (var seat in layout.Seats)
                {
                    <span class="mini-seat @(seat.IsBooked ? "booked" : "")" style="grid-column: @seat.X; grid-row: @seat.Y;"></span>
                }
            </div>
                </td>
            </tr>
        }
    </table>
</div>

    


   
