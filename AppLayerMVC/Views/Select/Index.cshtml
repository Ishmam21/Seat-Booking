@using BLL.Models;
@model List<LayoutModel>

@{
    ViewData["Title"] = "Select Layout";
}

<section class="layout-selection-page">
    <header class="layout-selection-heading">
        <p class="seat-page-eyebrow">Seatz</p>
        <h1>Choose a layout</h1>
        <p>Pick a seat map to see availability and prices.</p>
    </header>

    @if (Model.Count == 0)
    {
        <div class="layout-empty-state">
            <h2>No layouts yet</h2>
            <p>There aren’t any seat layouts to browse right now.</p>
        </div>
    }
    else
    {
        <div class="layout-card-grid">
            @foreach (var layout in Model)
            {
                <article class="layout-card">
                    <div class="layout-card-info">
                        <div>
                            <h2>@layout.Name</h2>
                            <p class="layout-seat-count">@layout.Seats.Count seat@(layout.Seats.Count == 1 ? "" : "s")</p>
                        </div>
                        <a href="@Url.Action("ViewLayout", "Book", new { id = layout.Id })" class="btn btn-primary">View seats</a>
                    </div>

                    <div class="layout-preview" role="img" aria-label="Preview of @layout.Name">
                        @if (layout.Seats.Count > 0)
                        {
                            <div class="mini-grid" style="grid-template-columns: repeat(@layout.Seats.Max(seat => seat.X), 12px)">
                                @foreach (var seat in layout.Seats)
                                {
                                    <span class="mini-seat @(seat.IsBooked ? "booked" : "")" style="grid-column: @seat.X; grid-row: @seat.Y;"></span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="layout-preview-empty">No seats in this layout</span>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>
