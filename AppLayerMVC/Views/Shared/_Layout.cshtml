@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();   // used to highlight the current tab
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Seatz</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600..700&family=Instrument+Sans:wght@400..600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* removed: the AppLayerMVC.styles.css link, because the scoped layout CSS file is being deleted *@
</head>
<body>
    <header class="site-header">
    <div class="container site-header-inner">
        <div class="site-header-left">
            <button type="button" class="back-btn" onclick="backConfirm()">&larr; Back</button>
            <a class="brand" asp-controller="Select" asp-action="Index">Seatz</a>
        </div>
        @* ADDED: wrapper so the existing nav and the new auth links sit together on the right *@
        <div class="site-header-right">
            <nav class="site-nav">
                <a class="@(controller == "Select" || controller == "Home" ? "active" : "")" asp-controller="Select" asp-action="Index">Layouts</a>
                <a class="@(controller == "Creator" ? "active" : "")" asp-controller="Creator" asp-action="Index">Create</a>
            </nav>
            @* ADDED: login / sign up. Account is the controller name I'm planning for the two pages (arbitrary, but it has to match the controller we build next) *@
            <div class="auth-links">
                <a class="auth-login" asp-controller="Account" asp-action="Login">Log in</a>
                <a class="auth-signup" asp-controller="Account" asp-action="Register">Sign up</a>
            </div>
        </div>
    </div>
</header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">Seatz &copy; 2026</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>