@model BLL.Models.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="auth-wrap">
    <div class="auth-card">
        <h1 class="auth-title">Seatz</h1>
        <p class="auth-sub">Create your account</p>

        <form asp-controller="Account" asp-action="Register" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="auth-error"></div>

            <div class="auth-field">
                <label asp-for="Email"></label>
                <input asp-for="Email" type="email" autocomplete="email" autofocus />
                <span asp-validation-for="Email" class="auth-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="DisplayName">Display name</label>
                <input asp-for="DisplayName" autocomplete="nickname" />
                <span asp-validation-for="DisplayName" class="auth-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Password"></label>
                <input asp-for="Password" type="password" autocomplete="new-password" />
                <span asp-validation-for="Password" class="auth-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="ConfirmPassword">Confirm password</label>
                <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="auth-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Role">I am a</label>
                <select asp-for="Role">
                    <option value="Customer">Customer (book seats)</option>
                    <option value="Vendor">Vendor (create layouts)</option>
                </select>
                <span asp-validation-for="Role" class="auth-error"></span>
            </div>

            <button type="submit" class="auth-btn">Register</button>
        </form>

        <p class="auth-alt">
            Already registered? <a asp-controller="Account" asp-action="Login">Log in</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}