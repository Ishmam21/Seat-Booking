@using BLL.Models;
@model Layout


@{
    ViewData["Title"] = "Seats";

    var Totalseats = Model.Seats.Where(s => s.IsSelected).Count();
    var TotalPrice = Model.Seats.Where(s => s.IsSelected).Sum(s => s.Price); 
}
<h1 style="text-align: center;margin-bottom: 20px;">Available Seats</h1>
<div class="legend">
    <div class="legend-item">
        <div class="legend-color available"></div>
        <span>Available</span>
    </div>
    <div class="legend-item">
        <div class="legend-color selected"></div>
        <span>Selected</span>
    </div>
    <div class="legend-item">
        <div class="legend-color booked"></div>
        <span>Booked</span>
    </div>
</div>  @* added: closes .legend, so the seat map is no longer nested inside it *@

<div class="seat-wrapper">
    <div>
        <h2>@Model.Name</h2>
    </div>
    <div class="seat-grid" style="grid-template-columns: repeat(@Model.Seats.Max(s => s.X), 48px)">
        @foreach (var seat in Model.Seats)
        {
            <button onclick="toggleSeatSelection(this)" class="seat @(seat.IsBooked ? "booked" : "") @(seat.IsSelected ? "selected" : "")"
            style="grid-column: @seat.X; grid-row: @seat.Y;"
            data-id="@seat.Id" data-price="@seat.Price" data-label="@seat.Label" @(seat.IsBooked ? "disabled" : "")>
                @seat.Label
                @seat.Price
                @* <span class="seat-price">Bdt @seat.Price.ToString("0.##")</span> *@
            </button>
        }
    </div>   @* closes .seat-grid *@
</div>       @* closes .seat-wrapper; removed: the third </div> that used to follow this one *@

<div class="summary">
    <div>Seats: <strong id="seat-count">0</strong></div>
    <div>Total: <strong id="seat-total">Bdt 0</strong></div>
</div>