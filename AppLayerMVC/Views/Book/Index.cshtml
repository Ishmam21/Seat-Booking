@using BLL.Models;
@model LayoutModel

@{
    ViewData["Title"] = Model.Name;
}

<section class="seat-booking-page">
    <div class="seat-page-heading">
        <div>
            <p class="seat-page-eyebrow">Seat selection</p>
            <h1>@Model.Name</h1>
            <p class="seat-page-subtitle">Click a seat with a 360° badge to open its image preview, then choose Explore 360° to view the image.</p>
        </div>
    </div>

    <section class="seat-map-panel" aria-label="Seat map">
        <div class="legend">
            <div class="legend-item">
                <div class="legend-color available"></div>
                <span>Available</span>
            </div>
            <div class="legend-item">
                <div class="legend-color selected"></div>
                <span>Selected</span>
            </div>
            <div class="legend-item">
                <div class="legend-color booked"></div>
                <span>Booked</span>
            </div>
        </div>

        <div class="seat-wrapper">
            <div class="seat-grid" style="grid-template-columns: repeat(@(Model.Seats.Count == 0 ? 1 : Model.Seats.Max(s => s.X)), 48px)">
                @foreach (var seat in Model.Seats)
                {
                    <button type="button" class="seat booking-seat @(seat.IsBooked ? "booked" : "")"
                            style="grid-column: @seat.X; grid-row: @seat.Y;"
                            data-seat-id="@seat.Id" data-price="@seat.Price" data-label="@seat.Label"
                            data-booked="@seat.IsBooked.ToString().ToLowerInvariant()"
                            data-thumb="@(seat.PreviewImageUrl ?? seat.ThumbUrl)"
                            aria-label="Seat @seat.Label, BDT @seat.Price@(seat.IsBooked ? ", booked" : "")">
                        <span class="seat-label">@seat.Label</span>
                        <span class="seat-price">@seat.Price</span>
                        @if (seat.HasPreview)
                        {
                            <span class="badge-360" aria-hidden="true">360°</span>
                        }
                    </button>
                }
            </div>
        </div>
    </section>

    <section class="booking-summary" aria-label="Booking summary">
        <div class="booking-summary-stats">
            <div class="booking-stat">
                <span class="booking-summary-label">Selected seats</span>
                <strong class="booking-summary-value" id="seat-count">0</strong>
            </div>
            <div class="booking-stat booking-stat-total">
                <span class="booking-summary-label">Total</span>
                <strong class="booking-summary-value" id="seat-total">BDT 0</strong>
            </div>
            <p class="booking-selected-list" id="selected-list" aria-live="polite">No seats selected</p>
        </div>
        <div class="booking-action">
            @if (User.IsInRole("Customer"))
            {
                <button type="button" class="btn btn-primary" onclick="bookSelectedSeats()">Book selected seats</button>
            }
            else
            {
                <button type="button" class="btn btn-primary" disabled aria-describedby="booking-restriction">Book selected seats</button>
                <span id="booking-restriction" class="booking-restriction">Booking is available to Customer accounts.</span>
            }
        </div>
    </section>
</section>

<aside id="preview-panel" class="seat-preview-panel" aria-label="Seat preview" aria-hidden="true">
    <h2 id="preview-title"></h2>
    <img id="preview-thumb" alt="Seat preview" />
    <p id="preview-image-error" class="preview-image-error" role="status" hidden>Seat image could not be loaded.</p>
    <button type="button" id="explore-360" class="btn btn-primary">Explore 360°</button>
    <button type="button" id="unselect-preview-seat" class="btn btn-secondary">Unselect</button>
</aside>

@Html.AntiForgeryToken()
